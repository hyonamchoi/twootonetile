# Google Gemini API Key (무료 발급: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 딜러 콘솔(/dealer)·iPad 시연(/showroom) 로그인 비밀번호.
# 개발 모드(npm run dev)에서 비워 두면 로그인 없이 열리고, 운영에서는 반드시 설정하세요.
DEALER_PASSWORD=change-me

# 딜러 세션 쿠키 서명용 비밀값 (긴 랜덤 문자열). 비우면 DEALER_PASSWORD에서 파생됩니다.
DEALER_SESSION_SECRET=

# (선택) 데이터 저장 위치. 기본값은 프로젝트의 ./data (카탈로그, 문의, 타일 이미지, 공유 디자인)
# DATA_DIR=./data

# (선택) 공유 링크·메타데이터에 쓰는 사이트 주소
# NEXT_PUBLIC_SITE_URL=https://tile.example.com
